# Pick one remote source. Leave all blank to preview local files in src/assets/gallery.

# Option A (recommended): public folder that serves original filenames.
# Cloudinary example: https://res.cloudinary.com/YOUR_CLOUD/image/upload/gallery
# Cloudflare R2 / S3 / ImageKit work the same way.
# VITE_GALLERY_BASE_URL=

# Option B: Google Drive folder shared as "Anyone with the link".
# Create a browser API key with Drive API enabled, then restrict it to your site.
# VITE_GALLERY_DRIVE_FOLDER_ID=
# VITE_GALLERY_DRIVE_API_KEY=
